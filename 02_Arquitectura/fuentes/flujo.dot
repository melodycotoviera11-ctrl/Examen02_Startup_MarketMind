digraph G {
  rankdir=LR; nodesep=0.25; ranksep=0.45; dpi=220;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#5B6B7A", fillcolor="#FFFFFF", penwidth=1.1, margin="0.12,0.06"];
  edge [color="#5B6B7A", arrowsize=0.6, penwidth=1.0];

  subgraph cluster_f { label="1. Fuentes"; fontname="Arial Bold"; fontsize=10; style="rounded,filled"; fillcolor="#EEF3F8"; color="#C7D3DF";
    f1 [label="Sistema de facturación\nclientes, planes, facturas"];
    f2 [label="API de plataformas de anuncios\nMeta, Google, TikTok, IA beta\nresultados diarios"];
    f3 [label="Hoja de control de campañas\ncampanas.xlsx"];
    f4 [label="Registro de actividad\ndel panel (logs)"];
    f5 [label="Contabilidad\ncostos operativos"];
  }
  subgraph cluster_s { label="2. Recepción (staging)"; fontname="Arial Bold"; fontsize=10; style="rounded,filled"; fillcolor="#EEF3F8"; color="#C7D3DF";
    s1 [label="Carpeta datos_brutos\nCSV y Excel sin cambios"];
  }
  subgraph cluster_e { label="3. ETL"; fontname="Arial Bold"; fontsize=10; style="rounded,filled"; fillcolor="#EEF3F8"; color="#C7D3DF";
    e1 [label="Power Query\nlimpieza, homologación,\nclaves y validaciones"];
  }
  subgraph cluster_d { label="4. Data mart"; fontname="Arial Bold"; fontsize=10; style="rounded,filled"; fillcolor="#EEF3F8"; color="#C7D3DF";
    d1 [label="Modelo estrella\n4 hechos, 5 dimensiones\ny calendario"];
  }
  subgraph cluster_m { label="5. Modelo semántico"; fontname="Arial Bold"; fontsize=10; style="rounded,filled"; fillcolor="#EEF3F8"; color="#C7D3DF";
    m1 [label="Medidas DAX\nroles RLS"];
  }
  subgraph cluster_p { label="6. Dashboards"; fontname="Arial Bold"; fontsize=10; style="rounded,filled"; fillcolor="#EEF3F8"; color="#C7D3DF";
    p1 [label="Panel del cliente"];
    p2 [label="Desempeño comercial"];
    p3 [label="Uso y retención"];
  }
  subgraph cluster_u { label="7. Usuarios"; fontname="Arial Bold"; fontsize=10; style="rounded,filled"; fillcolor="#EEF3F8"; color="#C7D3DF";
    u1 [label="Clientes\npymes y agencias\n(solo sus datos)"];
    u2 [label="Dirección de\nMarketMind"];
  }
  {f1 f2 f3 f4 f5} -> s1 -> e1 -> d1 -> m1;
  m1 -> {p1 p2 p3};
  p1 -> u1; p2 -> u2; p3 -> u2;
}
