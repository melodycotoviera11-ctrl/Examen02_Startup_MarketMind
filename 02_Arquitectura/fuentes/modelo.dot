graph G {
  layout=neato; overlap=false; splines=true; dpi=220; sep="+6";
  node [shape=plain, fontname="Arial", fontsize=9];
  edge [color="#5B6B7A", penwidth=1.0, fontname="Arial", fontsize=8];
  cal [pos="3.6,0!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#5B6B7A" bgcolor="#FFFFFF"><tr><td bgcolor="#D9D9D9"><b>Dim_Calendario</b></td></tr><tr><td align="left">PK Fecha</td></tr><tr><td align="left">Año, Mes, NombreMes</td></tr><tr><td align="left">Trimestre, DíaSemana</td></tr><tr><td align="left">EsFinDeSemana, Temporada</td></tr></table>>];
  fac [pos="0,2.5!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1F4E79" bgcolor="#EEF3F8"><tr><td bgcolor="#BDD7EE"><b>Hecho_Facturacion</b></td></tr><tr><td align="left">PK id_factura</td></tr><tr><td align="left">FK id_cliente, id_plan</td></tr><tr><td align="left">FK fecha_emision</td></tr><tr><td align="left">subtotal, descuento, iva, total</td></tr><tr><td align="left">dias_para_pagar, estado_pago</td></tr><tr><td align="left"><i>Grano una factura por cliente y mes</i></td></tr></table>>];
  res [pos="0,-2.6!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1F4E79" bgcolor="#EEF3F8"><tr><td bgcolor="#BDD7EE"><b>Hecho_ResultadosCampana</b></td></tr><tr><td align="left">PK id_resultado</td></tr><tr><td align="left">FK id_campana, id_cliente</td></tr><tr><td align="left">FK id_canal, fecha</td></tr><tr><td align="left">impresiones, clics, gasto</td></tr><tr><td align="left">conversiones, ingresos</td></tr><tr><td align="left"><i>Grano una campaña por día</i></td></tr></table>>];
  uso [pos="0,0!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1F4E79" bgcolor="#EEF3F8"><tr><td bgcolor="#BDD7EE"><b>Hecho_UsoPlataforma</b></td></tr><tr><td align="left">PK id_sesion</td></tr><tr><td align="left">FK id_cliente, fecha</td></tr><tr><td align="left">duracion_min, alertas_revisadas</td></tr><tr><td align="left">reporte_descargado, pagina</td></tr><tr><td align="left"><i>Grano una sesión</i></td></tr></table>>];
  cos [pos="7.0,0!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1F4E79" bgcolor="#EEF3F8"><tr><td bgcolor="#BDD7EE"><b>Hecho_Costos</b></td></tr><tr><td align="left">PK id_costo</td></tr><tr><td align="left">FK fecha, concepto, tipo_costo</td></tr><tr><td align="left">monto_crc</td></tr><tr><td align="left"><i>Grano un concepto por mes</i></td></tr></table>>];
  cli [pos="-3.6,0!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#5B6B7A" bgcolor="#FFFFFF"><tr><td bgcolor="#D9D9D9"><b>Dim_Cliente</b></td></tr><tr><td align="left">PK id_cliente</td></tr><tr><td align="left">nombre, industria, tamaño</td></tr><tr><td align="left">provincia, canal_adquisicion</td></tr><tr><td align="left">fecha_alta, fecha_baja, estado</td></tr></table>>];
  pla [pos="-3.6,2.7!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#5B6B7A" bgcolor="#FFFFFF"><tr><td bgcolor="#D9D9D9"><b>Dim_Plan</b></td></tr><tr><td align="left">PK id_plan</td></tr><tr><td align="left">nombre, precio, límites</td></tr></table>>];
  cam [pos="-3.6,-2.9!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#5B6B7A" bgcolor="#FFFFFF"><tr><td bgcolor="#D9D9D9"><b>Dim_Campana</b></td></tr><tr><td align="left">PK id_campana</td></tr><tr><td align="left">marca, industria_marca</td></tr><tr><td align="left">objetivo, fechas, presupuesto</td></tr></table>>];
  can [pos="3.6,-3.0!", label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#5B6B7A" bgcolor="#FFFFFF"><tr><td bgcolor="#D9D9D9"><b>Dim_Canal</b></td></tr><tr><td align="left">PK id_canal</td></tr><tr><td align="left">nombre, plataforma, tipo</td></tr></table>>];
  cal -- fac [label="1 : *"]; cal -- res [label="1 : *"]; cal -- uso [label="1 : *"]; cal -- cos [label="1 : *"];
  cli -- fac [label="1 : *"]; cli -- res [label="1 : *"]; cli -- uso [label="1 : *"];
  pla -- fac [label="1 : *"];
  cam -- res [label="1 : *"]; can -- res [label="1 : *"];
}
